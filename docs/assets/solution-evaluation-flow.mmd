    classDef decision fill:#fff4df,stroke:#d88920,color:#503510;
    classDef output fill:#edf0ff,stroke:#596bd6,color:#20295c;
    classDef note fill:#ffffff,stroke:#9aa8b2,color:#34444e,stroke-dasharray:4 3;

    class A source;
    class B,K,G,AG,R1,RR code;
    class C,P,R,S,RP llm;
    class V,V2,Q,RV,RV2,GT decision;
    class O,Z output;
    class NP note;
