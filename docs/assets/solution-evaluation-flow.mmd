%%{init: {"flowchart": {"defaultRenderer": "elk", "curve": "linear", "nodeSpacing": 28, "rankSpacing": 42}}}%%
flowchart TB
    subgraph P1["1 · VALIDATE"]
        direction TB
        A["Generated Question<br/>đề bài · solution · answerSpec"]
        B["Structural Validator<br/>shape · ID · reference · cardinality"]
        BG{"Có schema issue<br/>blocking?"}
        A --> B --> BG
    end

    subgraph P2["2 · CONTEXT & TRANSITIONS"]
        direction TB
        C["Gemma 12B Splitter<br/>ordered states · context requirements<br/>đọc ảnh một lần nếu có"]
        C0{"Gemma Splitter<br/>canonical?"}
        CF["Nếu output không canonical<br/>Code Splitter tách states từ text"]
        CG{"Code fallback<br/>thành công?"}
        D{"Context bắt buộc<br/>available?"}
        E["Internal Context Builder<br/>kiểm mô tả ảnh · chèn vào bản sao stem"]
        F["Transition Builder + Code Analyzer<br/>ordered transitions · hard-invalid hints"]
        C --> C0
        C0 -->|Có| D
        C0 -->|Không| CF --> CG
        CG -->|Có| D
        D -->|Có| E --> F
    end

    subgraph P3["3 · SPECIALIZED JUDGES"]
        direction TB
        X["Chạy song song"]
        G1["Gemma 26B Correctness<br/>đúng/sai toán học · lập luận · lỗi đầu tiên"]
        G2["Gemma 12B Process & Presentation<br/>thiếu bước · nháp · lặp · wording"]
        V{"Cả hai output<br/>canonical?"}
        RT{"Có runtime<br/>failure?"}
        CC["Một correction call tối đa / object<br/>một scope: chính model đó<br/>hai scope: combined Gemma 26B"]
        VC{"Sau correction<br/>cả hai canonical?"}
        X --> G1 --> V
        X --> G2 --> V
        V -->|Không| RT
        RT -->|Không| CC --> VC
    end

    subgraph P4["4 · AGGREGATE & RESOLVE"]
        direction TB
        M["Code áp dụng hard-invalid bắt buộc<br/>chỉ khi evidence grounded và được dùng tiếp"]
        H["Aggregate hai Judge canonical<br/>chọn issue sớm nhất"]
        I{"Final solution<br/>is_good = true?"}
        IC{"Có interaction context<br/>để đối chiếu?"}
        K["Gemma 26B Solution Resolver<br/>solution ↔ answerSpec/options/hints<br/>gọi đúng một lần"]
        KR{"Resolver canonical<br/>và resolved?"}
        MR["Merge resolver result<br/>answer mismatch · fields_to_fix"]
        M --> H --> I
        I -->|Có| IC
        IC -->|Có| K --> KR
        KR -->|Có| MR
    end

    subgraph P5["5 · REPAIR & OUTPUT"]
        direction TB
        Q["Canonical checked result"]
        AR{"auto_repair=true<br/>và có issue repairable?"}
        RP["Scoped Repair + re-evaluate<br/>clean solution trước<br/>sau đó align answer/hint/schema<br/>lặp tối đa max_loop"]
        O["Public Output<br/>is_good · issues · new_generated_question"]
        Q --> AR
        AR -->|Không| O
        AR -->|Có| RP --> O
    end

    STOP["Fail closed / Needs review<br/>giữ canonical issue<br/>không gọi Resolver"]

    BG -->|Không| C
    BG -->|Có| STOP
    CG -->|Không| STOP
    D -->|Không| STOP
    F --> X
    V -->|Có| M
    RT -->|Có| STOP
    VC -->|Có| M
    VC -->|Không| STOP
    I -->|Không| Q
    IC -->|Không| Q
    KR -->|Không| STOP
    MR --> Q
    STOP --> Q

    N1["Ảnh chỉ gửi cho Splitter.<br/>Correctness chỉ nhận mô tả text."]
    N2["Analyzer không quyết định public verdict.<br/>Correctness không chấm trình bày;<br/>Process không tính lại toán học."]
    N3["Mọi handoff non-canonical còn lại<br/>đều fail closed trước Resolver."]

    N1 -.-> C
    N2 -.-> F
    N3 -.-> STOP

